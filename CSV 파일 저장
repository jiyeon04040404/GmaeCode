using System.Collections.Generic;
using UnityEngine;
using System.IO;

public class SysCSV : MonoBehaviour
{
    public struct CsvData
    {
        public int Number { get; set; }
        public string Question { get; set; }
        public string Answer { get; set; }

        public override string ToString() => $"{Number},{Question},{Answer}";
    }

    private int messageCount = 0; // 메시지 순서를 위한 카운터
    private string m_FileName = "LOG_record"; // 파일 이름
    private string filePath;

    private void Start()
    {
        // 사용자 Desktop 폴더에 파일을 저장
        string desktopPath = System.Environment.GetFolderPath(System.Environment.SpecialFolder.Desktop);
        filePath = Path.Combine(desktopPath, m_FileName + ".csv");
    }

    // 질문과 답변을 CSV에 저장하는 메서드
    public void LogToCsv(string question, string answer)
    {
        messageCount++; // 메시지 번호 증가
        var newCsvData = new List<CsvData>()
        {
            new CsvData { Number = messageCount, Question = question, Answer = answer }
        };

        // CSV 파일에 데이터 추가
        AppendCsv(filePath, newCsvData);
    }

    // CSV 파일에 데이터를 추가하는 함수
    public static void AppendCsv(string filePath, List<CsvData> csvDatas)
    {
        bool fileExists = File.Exists(filePath);

        using (StreamWriter sw = new StreamWriter(filePath, true))
        {
            if (!fileExists)
            {
                // 파일이 없을 경우 헤더 작성
                sw.WriteLine("Number,Question,Answer");
            }

            // 데이터 추가
            foreach (var csvData in csvDatas)
            {
                sw.WriteLine(csvData.ToString());
            }
        }
    }
}
