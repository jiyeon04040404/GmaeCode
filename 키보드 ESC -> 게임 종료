using UnityEngine;

public class QuitOnEsc : MonoBehaviour
{
    void Update()
    {
        // Esc 키가 눌렸는지 확인
        if (Input.GetKeyDown(KeyCode.Escape))
        {
            // 게임 종료
            QuitGame();
        }
    }

    // 게임 종료 메서드
    void QuitGame()
    {
        // 에디터 모드에서는 플레이 모드를 종료
#if UNITY_EDITOR
        UnityEditor.EditorApplication.isPlaying = false;
#else
        // 빌드된 게임에서는 애플리케이션 종료
        Application.Quit();
#endif
    }
}
